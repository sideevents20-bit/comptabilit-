# ============================================================
# Configuration du script de traitement des factures
# Copiez ce fichier vers ".env" puis renseignez vos valeurs.
# Le fichier .env ne doit JAMAIS être partagé ni versionné.
# ============================================================

# --- Identifiants IMAP (obligatoires) -----------------------
# Boîte dédiée aux factures : mtgsud.compta@gmail.com
# Le mot de passe est un MOT DE PASSE D'APPLICATION Google (16 caractères),
# pas le mot de passe du compte : compte Google -> Sécurité -> Validation
# en deux étapes (à activer) -> Mots de passe des applications.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=mtgsud.compta@gmail.com
IMAP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Boîte à relever. La boîte étant entièrement dédiée aux factures,
# on relève directement la boîte de réception.
IMAP_FOLDER=INBOX

# --- Filtre destinataire (optionnel) ------------------------
# Inutile avec une boîte dédiée ; sert uniquement si vous relevez une
# boîte partagée via un alias (ex: adresse+factures@gmail.com).
FILTRE_DESTINATAIRE=

# --- Chemins (optionnels, valeurs par défaut ci-dessous) ----
# Dossier de classement final des factures par client
DOSSIER_BASE=./Factures_Clients
# Dossier temporaire de téléchargement des PDF
DOSSIER_TEMP=./_temp_factures
# Tableau Excel global de TVA
FICHIER_EXCEL=./tableau_tva_global.xlsx
# Liste des clients (un nom par ligne)
FICHIER_CLIENTS=./clients.txt

# --- Filtrage des emails ------------------------------------
# Mots-clés recherchés dans l'objet (séparés par des virgules)
MOTS_CLES_OBJET=facture,invoice
